import { InputLine } from "../widgets.slint";
import { ScrollView, Switch } from "std-widgets.slint";
import { RelayItem } from "../models.slint";
import { Title, Muted, Button } from "../widgets.slint";
import { RelayPicker } from "../relay_picker.slint";

export component SettingsPage inherits ScrollView {
    in property <string> npub;
    in property <string> nsec;
    in property <[RelayItem]> relays;
    in-out property <bool> show-reset-identity;
    callback relay-toggled(string, string, bool);
    callback relay-added(string, string);
    callback reveal-nsec();
    callback open-profile(string);
    callback import-nsec(string);

    content-width: self.visible-width;

    VerticalLayout {
        width: root.visible-width;
        padding: 16px;
        spacing: 10px;
        alignment: start;
        Title {
            text: "Your key";
        }

        InputLine {
            text: root.npub;
            read-only: true;
        }

        HorizontalLayout {
            spacing: 8px;
            Button {
                text: "Your profile";
                clicked => {
                    root.open-profile(root.npub);
                }
            }

            Button {
                text: root.nsec == "" ? "Reveal nsec" : "Hide nsec";
                clicked => {
                    root.reveal-nsec();
                }
            }
        }

        if root.nsec != "": InputLine {
            text: root.nsec;
            read-only: true;
        }

        Title {
            text: "Relays";
        }

        RelayPicker {
            id: "settings";
            items: root.relays;
            toggled(id, url, on) => {
                root.relay-toggled(id, url, on);
            }
            added(id, url) => {
                root.relay-added(id, url);
            }
        }

        // out of the way, as it replaces who we are
        Text {
            text: (root.show-reset-identity ? "▾" : "▸") + " Reset identity";
            color: #c62828;
            font-weight: 700;
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.show-reset-identity = !root.show-reset-identity;
                }
            }
        }

        if root.show-reset-identity: VerticalLayout {
            spacing: 8px;
            Muted {
                text: "Switch to another key you used before. This one stops being yours here: its trade reviews stay with it. Save its nsec first if you may want it back. Only possible with no open offers or ongoing trades.";
            }

            HorizontalLayout {
                spacing: 8px;
                import-field := InputLine {
                    placeholder-text: "nsec1…";
                    input-type: password;
                }

                Button {
                    text: "Import";
                    enabled: import-field.text != "";
                    clicked => {
                        root.import-nsec(import-field.text);
                        import-field.text = "";
                    }
                }
            }
        }
    }
}
