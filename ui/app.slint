import { Button, LineEdit, TextEdit, ComboBox, CheckBox, ScrollView, ListView, Switch, Palette } from "std-widgets.slint";

export struct OfferItem {
    id: string,
    maker: string,
    maker-short: string,
    maker-label: string,
    mine: bool,
    side: string,
    currency: string,
    price-api: string,
    premium: string,
    price: string,
    payments: string,
    bitcoin: string,
    relays: string,
    description: string,
    age: string,
}

export struct TradeItem {
    // the peer's npub for an ongoing trade, the history id for a past one
    key: string,
    peer-short: string,
    label: string,
    summary: string,
    status: string,
    last: string,
    blocked: bool,
}

export struct TradeView {
    ongoing: bool,
    peer: string,
    peer-short: string,
    label: string,
    blocked: bool,
    summary: string,
    status: string,
    started: string,
}

export struct MsgItem {
    mine: bool,
    text: string,
    time: string,
}

export struct ReportItem {
    author-short: string,
    success: bool,
    comment: string,
    time: string,
}

export struct PersonItem {
    npub: string,
    short: string,
    label: string,
}

export struct RelayItem {
    url: string,
    enabled: bool,
}

export struct PayItem {
    name: string,
    checked: bool,
}

component Card inherits Rectangle {
    background: Palette.alternate-background;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
}

component Title inherits Text {
    font-size: 20px;
    font-weight: 700;
    wrap: word-wrap;
}

component Muted inherits Text {
    color: Palette.foreground.transparentize(40%);
    font-size: 12px;
    wrap: word-wrap;
}

component Tip inherits Rectangle {
    in property <string> text;
    background: #f7931a22;
    border-radius: 6px;
    VerticalLayout {
        padding: 8px;
        Text {
            text: root.text;
            wrap: word-wrap;
            font-size: 12px;
        }
    }
}

component NavButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    height: 52px;
    background: area.pressed ? Palette.selection-background.transparentize(60%) : transparent;
    area := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    Text {
        text: root.text;
        color: root.active ? #f7931a : Palette.foreground;
        font-weight: root.active ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component SideBadge inherits Rectangle {
    in property <string> side;
    width: 48px;
    height: 22px;
    border-radius: 4px;
    background: side == "sell" ? #2e7d32 : #1565c0;
    Text {
        // from the taker's point of view: a maker who sells is someone you can buy from
        text: root.side == "sell" ? "SELLS" : "BUYS";
        color: white;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// our private name for someone, styled so it stands out from npubs
component Label inherits Rectangle {
    in property <string> text;
    background: #f7931a;
    border-radius: 4px;
    height: 20px;
    width: min(t.preferred-width + 12px, 180px);
    t := Text {
        text: root.text;
        width: parent.width - 12px;
        overflow: elide;
        horizontal-alignment: center;
        color: white;
        font-size: 12px;
        font-weight: 700;
        vertical-alignment: center;
    }
}

component TradeCard inherits Rectangle {
    in property <TradeItem> item;
    callback clicked;
    background: Palette.alternate-background;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
    opacity: root.item.blocked ? 0.5 : 1;
    TouchArea {
        clicked => {
            root.clicked();
        }
    }

    VerticalLayout {
        padding: 10px;
        spacing: 2px;
        HorizontalLayout {
            spacing: 6px;
            if root.item.label != "": Label {
                text: root.item.label;
            }
            Text {
                text: root.item.peer-short + (root.item.blocked ? " (blocked)" : "");
                font-weight: root.item.label != "" ? 400 : 700;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        Text {
            text: root.item.status;
            color: #f7931a;
            font-size: 12px;
            font-weight: 700;
            wrap: word-wrap;
        }

        Muted {
            text: root.item.summary;
        }

        if root.item.last != "": Text {
            text: root.item.last;
            overflow: elide;
            font-size: 13px;
        }
    }
}

export component AppWindow inherits Window {
    title: "bitcoin small";
    preferred-width: 420px;
    preferred-height: 820px;
    background: Palette.background;

    // 0 market, 1 offer, 2 create, 3 trades, 4 trade, 5 profile, 6 settings, 7 people
    in-out property <int> page: 0;
    in-out property <int> back-page: 0;
    in property <string> status;
    in property <string> npub;
    in property <string> nsec;

    // market
    in property <[OfferItem]> offers;
    in property <[string]> currencies;
    in-out property <string> filter-side: "all";
    in-out property <string> filter-currency: "all";
    in property <bool> loading;
    in property <OfferItem> current-offer;
    callback refresh-offers();
    callback filters-changed();
    callback open-offer(string);
    callback contact-maker(string);

    // create
    in property <[string]> create-currencies;
    in property <[string]> create-apis;
    // payment methods common for the chosen currency, and the rest behind "show more"
    in-out property <[PayItem]> payment-options;
    in-out property <[PayItem]> payment-more;
    in-out property <[PayItem]> bitcoin-options;
    in-out property <string> create-side: "sell";
    in-out property <string> create-currency;
    in-out property <string> create-api;
    in-out property <string> create-premium;
    in-out property <string> create-other-payments;
    in-out property <string> create-relays;
    in-out property <string> create-description;
    in property <string> create-preview;
    in-out property <bool> create-custom;
    in-out property <bool> create-more-payments;
    callback create-currency-changed(string);
    callback create-api-changed(string);
    callback create-premium-changed();
    callback toggle-payment(string, bool);
    callback toggle-bitcoin(string, bool);
    callback publish-offer();

    // trades
    in property <[OfferItem]> my-offers;
    in property <[TradeItem]> ongoing-trades;
    in property <[TradeItem]> past-trades;
    in property <TradeView> trade;
    in property <[MsgItem]> messages;
    in-out property <bool> trade-concluding;
    in-out property <bool> trade-confirm-delete;
    callback open-trade(string);
    callback open-past-trade(string);
    callback close-offer(string);
    callback send-message(string);
    callback conclude-trade(bool, string);
    callback archive-trade();
    callback delete-trade();

    // profile
    in property <string> profile-npub;
    in property <string> profile-short;
    in property <string> profile-label;
    in property <bool> profile-blocked;
    in property <bool> profile-is-me;
    in property <[ReportItem]> own-reports;
    in property <[ReportItem]> others-reports;
    in property <string> others-note;
    callback open-profile(string);
    callback report-trade(bool, string);
    callback set-blocked(bool);
    callback set-label(string);

    // people
    in property <[PersonItem]> people;
    in-out property <string> people-filter;
    callback people-filter-changed(string);

    // settings
    in property <[RelayItem]> relays;
    callback toggle-relay(string, bool);
    callback remove-relay(string);
    callback add-relay(string);
    callback reveal-nsec();
    callback open-docs();
    callback import-nsec(string);

    // on wide screens the content stays in a column of at most this width, centered
    property <length> max-content-width: 1200px;
    property <length> side-gap: max(0px, (root.width - root.max-content-width) / 2);

    VerticalLayout {
        // header, extended under the status bar on phones that draw behind it
        Rectangle {
            height: 52px + root.safe-area-insets.top;
            background: #f7931a;
            HorizontalLayout {
                padding-top: root.safe-area-insets.top + 8px;
                padding-bottom: 8px;
                padding-left: root.safe-area-insets.left + root.side-gap + 16px;
                padding-right: root.safe-area-insets.right + root.side-gap + 16px;
                spacing: 8px;
                if root.page == 1 || root.page == 4 || root.page == 5: Button {
                    text: "‹";
                    clicked => {
                        // the trade view is reached from the trades tab, or from a profile opened from it
                        root.page = root.page == 4 ? 3 : root.back-page;
                    }
                }
                Text {
                    text: "bitcoin small";
                    color: white;
                    font-size: 18px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Text {
                    text: root.status;
                    color: white;
                    font-size: 11px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }

        // pages
        HorizontalLayout {
            vertical-stretch: 1;
            padding-left: root.safe-area-insets.left + root.side-gap;
            padding-right: root.safe-area-insets.right + root.side-gap;
            Rectangle {
                // ---------------------------------------------------------------- market
                if root.page == 0: VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Tip {
                        text: "New here? Read how this works and how to trade safely →";
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.open-docs();
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        ComboBox {
                            model: ["all", "sell", "buy"];
                            current-value <=> root.filter-side;
                            selected => {
                                root.filters-changed();
                            }
                        }

                        ComboBox {
                            model: root.currencies;
                            current-value <=> root.filter-currency;
                            selected => {
                                root.filters-changed();
                            }
                        }

                        Button {
                            text: root.loading ? "…" : "Refresh";
                            enabled: !root.loading;
                            clicked => {
                                root.refresh-offers();
                            }
                        }
                    }

                    if root.offers.length == 0: Muted {
                        text: root.loading ? "loading offers from the last 3 hours…" : "no offers in the last 3 hours. create one!";
                        horizontal-alignment: center;
                    }
                    ListView {
                        vertical-stretch: 1;
                        for offer in root.offers: VerticalLayout {
                            padding-bottom: 8px;
                            padding-right: 6px;
                            Card {
                                TouchArea {
                                    clicked => {
                                        root.open-offer(offer.id);
                                    }
                                }

                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 4px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        SideBadge {
                                            side: offer.side;
                                        }

                                        Text {
                                            text: offer.currency + " " + offer.premium;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: offer.price;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                    }

                                    Text {
                                        text: offer.payments;
                                        wrap: word-wrap;
                                        font-size: 13px;
                                    }

                                    if offer.description != "": Text {
                                        text: offer.description;
                                        wrap: word-wrap;
                                        overflow: elide;
                                        max-height: 40px;
                                        font-size: 13px;
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        if offer.maker-label != "": Label {
                                            text: offer.maker-label;
                                        }
                                        Muted {
                                            text: (offer.mine ? "you" : offer.maker-short) + " · " + offer.age;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ---------------------------------------------------------------- offer detail
                if root.page == 1: sv1 := ScrollView {
                    VerticalLayout {
                        width: sv1.visible-width;
                        padding: 16px;
                        spacing: 10px;
                        alignment: start;
                        HorizontalLayout {
                            spacing: 8px;
                            SideBadge {
                                side: root.current-offer.side;
                            }

                            Title {
                                text: "bitcoin for " + root.current-offer.currency;
                            }
                        }

                        Muted {
                            text: root.current-offer.side == "sell" ? "the maker sells bitcoin and receives fiat" : "the maker buys bitcoin and pays fiat";
                        }

                        Card {
                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;
                                Text {
                                    text: "price: market " + root.current-offer.premium + " (" + root.current-offer.price-api + ")";
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: root.current-offer.price;
                                    font-weight: 700;
                                }

                                Text {
                                    text: "payment: " + root.current-offer.payments;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: "bitcoin via: " + root.current-offer.bitcoin;
                                    wrap: word-wrap;
                                }

                                Muted {
                                    text: "negotiation relays: " + root.current-offer.relays;
                                }

                                Muted {
                                    text: "posted " + root.current-offer.age;
                                }
                            }
                        }

                        if root.current-offer.description != "": Card {
                            VerticalLayout {
                                padding: 12px;
                                Text {
                                    text: root.current-offer.description;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        if root.current-offer.maker-label != "": HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Text {
                                text: "maker:";
                                vertical-alignment: center;
                            }

                            Label {
                                text: root.current-offer.maker-label;
                            }
                        }
                        Muted {
                            text: "maker: " + root.current-offer.maker;
                        }

                        Button {
                            text: "Maker's trade history";
                            clicked => {
                                root.open-profile(root.current-offer.maker);
                            }
                        }

                        if !root.current-offer.mine: Button {
                            text: "Contact maker";
                            primary: true;
                            clicked => {
                                root.contact-maker(root.current-offer.id);
                            }
                        }
                        if root.current-offer.mine: Muted {
                            text: "this is your offer. takers will show up in Trades.";
                        }
                        if root.current-offer.mine: Button {
                            text: "Close offer";
                            clicked => {
                                root.close-offer(root.current-offer.id);
                                root.page = 0;
                            }
                        }
                    }
                }

                // ---------------------------------------------------------------- create
                if root.page == 2: sv2 := ScrollView {
                    VerticalLayout {
                        width: sv2.visible-width;
                        padding: 16px;
                        spacing: 12px;
                        alignment: start;
                        Title {
                            text: "New offer";
                        }

                        Muted {
                            text: "offers expire after 3 hours. they carry only your npub, no username. the form remembers what you usually pick.";
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "I want to";
                                vertical-alignment: center;
                            }

                            ComboBox {
                                model: ["sell", "buy"];
                                current-value <=> root.create-side;
                            }

                            Text {
                                text: "bitcoin for";
                                vertical-alignment: center;
                            }

                            ComboBox {
                                model: root.create-currencies;
                                current-value <=> root.create-currency;
                                selected(c) => {
                                    root.create-currency-changed(c);
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "premium";
                                vertical-alignment: center;
                            }

                            LineEdit {
                                text <=> root.create-premium;
                                placeholder-text: "+1%";
                                input-type: InputType.text;
                                edited => {
                                    root.create-premium-changed();
                                }
                            }
                        }

                        Muted {
                            text: root.create-preview;
                        }

                        Muted {
                            text: "\"+1%\" means bitcoin goes 1% more expensive than the market price; empty means 0%.";
                        }

                        Text {
                            text: "bitcoin sent via";
                            font-weight: 700;
                        }

                        VerticalLayout {
                            for row[r] in Math.ceil(root.bitcoin-options.length / 3): HorizontalLayout {
                                spacing: 8px;
                                for col in 3: Rectangle {
                                    horizontal-stretch: 1;
                                    height: 32px;
                                    if r * 3 + col < root.bitcoin-options.length: CheckBox {
                                        x: 0;
                                        width: parent.width;
                                        text: root.bitcoin-options[r * 3 + col].name;
                                        checked: root.bitcoin-options[r * 3 + col].checked;
                                        toggled => {
                                            root.toggle-bitcoin(self.text, self.checked);
                                        }
                                    }
                                }
                            }
                        }

                        Text {
                            text: "fiat payment methods";
                            font-weight: 700;
                        }

                        VerticalLayout {
                            // a simple two-column grid of checkboxes
                            for row[r] in Math.ceil(root.payment-options.length / 2): HorizontalLayout {
                                spacing: 8px;
                                for col in 2: Rectangle {
                                    horizontal-stretch: 1;
                                    height: 32px;
                                    if r * 2 + col < root.payment-options.length: CheckBox {
                                        x: 0;
                                        width: parent.width;
                                        text: root.payment-options[r * 2 + col].name;
                                        checked: root.payment-options[r * 2 + col].checked;
                                        toggled => {
                                            root.toggle-payment(self.text, self.checked);
                                        }
                                    }
                                }
                            }
                        }

                        if root.payment-more.length > 0: Text {
                            text: root.create-more-payments ? "show less" : "show more (" + root.payment-more.length + ")";
                            color: #f7931a;
                            font-size: 13px;
                            TouchArea {
                                clicked => {
                                    root.create-more-payments = !root.create-more-payments;
                                }
                            }
                        }

                        if root.create-more-payments: VerticalLayout {
                            spacing: 0px;
                            for row[r] in Math.ceil(root.payment-more.length / 2): HorizontalLayout {
                                spacing: 8px;
                                for col in 2: Rectangle {
                                    horizontal-stretch: 1;
                                    height: 32px;
                                    if r * 2 + col < root.payment-more.length: CheckBox {
                                        x: 0;
                                        width: parent.width;
                                        text: root.payment-more[r * 2 + col].name;
                                        checked: root.payment-more[r * 2 + col].checked;
                                        toggled => {
                                            root.toggle-payment(self.text, self.checked);
                                        }
                                    }
                                }
                            }
                        }

                        LineEdit {
                            text <=> root.create-other-payments;
                            placeholder-text: "other payment methods, comma-separated";
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Switch {
                                checked <=> root.create-custom;
                            }

                            Text {
                                text: "custom price source, relays and description";
                                vertical-alignment: center;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                        }

                        if root.create-custom: VerticalLayout {
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "market price from";
                                    vertical-alignment: center;
                                }

                                ComboBox {
                                    model: root.create-apis;
                                    current-value <=> root.create-api;
                                    selected(a) => {
                                        root.create-api-changed(a);
                                    }
                                }
                            }

                            Text {
                                text: "relays for the negotiation";
                                font-weight: 700;
                            }

                            LineEdit {
                                text <=> root.create-relays;
                                placeholder-text: "wss://…, comma-separated";
                            }

                            Text {
                                text: "description";
                                font-weight: 700;
                            }

                            TextEdit {
                                text <=> root.create-description;
                                min-height: 90px;
                                wrap: word-wrap;
                            }
                        }

                        Button {
                            text: "Publish offer";
                            primary: true;
                            clicked => {
                                root.publish-offer();
                            }
                        }
                    }
                }

                // ---------------------------------------------------------------- trades
                if root.page == 3: sv3 := ScrollView {
                    VerticalLayout {
                        width: sv3.visible-width;
                        padding: 16px;
                        spacing: 10px;
                        alignment: start;
                        Title {
                            text: "Your open offers";
                        }

                        if root.my-offers.length == 0: Muted {
                            text: "none. offers last 3 hours.";
                        }
                        for offer in root.my-offers: Card {
                            HorizontalLayout {
                                padding: 10px;
                                spacing: 8px;
                                SideBadge {
                                    side: offer.side;
                                    y: (parent.height - self.height) / 2;
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: offer.currency + " " + offer.premium + " · " + offer.price;
                                        font-weight: 700;
                                        overflow: elide;
                                    }

                                    Muted {
                                        text: offer.payments + " · posted " + offer.age;
                                    }
                                }

                                Button {
                                    text: "Close";
                                    clicked => {
                                        root.close-offer(offer.id);
                                    }
                                }
                            }
                        }

                        Title {
                            text: "Ongoing";
                        }

                        if root.ongoing-trades.length == 0: Muted {
                            text: "no ongoing trades. contact a maker in the market, or wait for takers of your offers.";
                        }
                        for t in root.ongoing-trades: TradeCard {
                            item: t;
                            clicked => {
                                root.open-trade(t.key);
                            }
                        }

                        if root.past-trades.length > 0: Title {
                            text: "History";
                        }
                        for t in root.past-trades: TradeCard {
                            item: t;
                            opacity: 0.75;
                            clicked => {
                                root.open-past-trade(t.key);
                            }
                        }
                    }
                }

                // ---------------------------------------------------------------- trade
                if root.page == 4: VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        if root.trade.label != "": Label {
                            text: root.trade.label;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: root.trade.peer-short + (root.trade.blocked ? " (blocked)" : "");
                            font-weight: root.trade.label != "" ? 400 : 700;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        Button {
                            text: "Profile";
                            clicked => {
                                root.open-profile(root.trade.peer);
                            }
                        }
                    }

                    Card {
                        VerticalLayout {
                            padding: 10px;
                            spacing: 2px;
                            Text {
                                text: root.trade.summary;
                                wrap: word-wrap;
                                font-size: 13px;
                            }

                            Text {
                                text: root.trade.status;
                                font-weight: 700;
                                font-size: 13px;
                                wrap: word-wrap;
                            }

                            Muted {
                                text: root.trade.started;
                            }
                        }
                    }

                    if !root.trade-concluding: HorizontalLayout {
                        spacing: 8px;
                        if root.trade.ongoing: Button {
                            text: "Conclude";
                            clicked => {
                                root.trade-concluding = true;
                            }
                        }
                        if root.trade.ongoing: Button {
                            text: "Archive";
                            clicked => {
                                root.archive-trade();
                            }
                        }
                        Button {
                            text: root.trade-confirm-delete ? "Really delete?" : "Delete";
                            clicked => {
                                if root.trade-confirm-delete {
                                    root.delete-trade();
                                } else {
                                    root.trade-confirm-delete = true;
                                }
                            }
                        }
                    }

                    if root.trade-concluding: Card {
                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;
                            Text {
                                text: "How did it go?";
                                font-weight: 700;
                            }

                            conclusion := LineEdit {
                                placeholder-text: "optional comment, e.g. \"$5 via PIX, fast\"";
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: "✓ Success";
                                    clicked => {
                                        root.conclude-trade(true, conclusion.text);
                                    }
                                }

                                Button {
                                    text: "✗ Failure";
                                    clicked => {
                                        root.conclude-trade(false, conclusion.text);
                                    }
                                }

                                Button {
                                    text: "Cancel";
                                    clicked => {
                                        root.trade-concluding = false;
                                    }
                                }
                            }

                            Muted {
                                text: "this publishes a trade report about them to your relays and moves the trade to your history. use Archive to put it away without a report.";
                            }
                        }
                    }

                    ListView {
                        vertical-stretch: 1;
                        for msg in root.messages: HorizontalLayout {
                            padding-bottom: 6px;
                            padding-right: 6px;
                            alignment: msg.mine ? end : start;
                            Rectangle {
                                max-width: 300px;
                                border-radius: 10px;
                                background: msg.mine ? #f7931a33 : Palette.alternate-background;
                                VerticalLayout {
                                    padding: 8px;
                                    Text {
                                        text: msg.text;
                                        wrap: word-wrap;
                                    }

                                    Muted {
                                        text: msg.time;
                                        horizontal-alignment: right;
                                    }
                                }
                            }
                        }
                    }

                    if root.trade.ongoing && !root.trade.blocked: HorizontalLayout {
                        spacing: 8px;
                        input := LineEdit {
                            placeholder-text: "message";
                            accepted => {
                                root.send-message(self.text);
                                self.text = "";
                            }
                        }

                        Button {
                            text: "Send";
                            clicked => {
                                root.send-message(input.text);
                                input.text = "";
                            }
                        }
                    }
                    if !root.trade.ongoing: Muted {
                        text: "this trade is over. messages are kept here as they were.";
                    }
                }

                // ---------------------------------------------------------------- profile
                if root.page == 5: sv5 := ScrollView {
                    VerticalLayout {
                        width: sv5.visible-width;
                        padding: 16px;
                        spacing: 10px;
                        alignment: start;
                        Title {
                            text: root.profile-is-me ? "You" : root.profile-label != "" ? root.profile-label : root.profile-short;
                        }

                        LineEdit {
                            text: root.profile-npub;
                            read-only: true;
                        }

                        if !root.profile-is-me: HorizontalLayout {
                            spacing: 8px;
                            label-input := LineEdit {
                                text: root.profile-label;
                                placeholder-text: "label, only you see it";
                                accepted => {
                                    root.set-label(self.text);
                                }
                            }

                            Button {
                                text: "Save";
                                enabled: label-input.text != root.profile-label;
                                clicked => {
                                    root.set-label(label-input.text);
                                }
                            }
                        }

                        if !root.profile-is-me: HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Message";
                                enabled: !root.profile-blocked;
                                clicked => {
                                    root.open-trade(root.profile-npub);
                                }
                            }

                            Button {
                                text: root.profile-blocked ? "Unblock" : "Block";
                                clicked => {
                                    root.set-blocked(!root.profile-blocked);
                                }
                            }
                        }

                        Text {
                            text: root.profile-is-me ? "Your trade reports" : "Our history with them";
                            font-weight: 700;
                        }

                        if root.own-reports.length == 0: Muted {
                            text: "you have never traded with them.";
                        }
                        for rep in root.own-reports: Card {
                            HorizontalLayout {
                                padding: 8px;
                                spacing: 8px;
                                Text {
                                    text: rep.success ? "✓" : "✗";
                                    color: rep.success ? #2e7d32 : #c62828;
                                    font-weight: 700;
                                }

                                Text {
                                    text: rep.comment != "" ? rep.comment : (rep.success ? "successful trade" : "failed trade");
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }

                                Muted {
                                    text: rep.time;
                                }
                            }
                        }

                        if !root.profile-is-me: Text {
                            text: "What the people we trust say";
                            font-weight: 700;
                        }

                        if !root.profile-is-me: Muted {
                            text: root.others-note;
                        }

                        for rep in root.others-reports: Card {
                            HorizontalLayout {
                                padding: 8px;
                                spacing: 8px;
                                Text {
                                    text: rep.success ? "✓" : "✗";
                                    color: rep.success ? #2e7d32 : #c62828;
                                    font-weight: 700;
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    Text {
                                        text: rep.comment != "" ? rep.comment : (rep.success ? "successful trade" : "failed trade");
                                        wrap: word-wrap;
                                    }

                                    Muted {
                                        text: "by " + rep.author-short + " · " + rep.time;
                                    }
                                }
                            }
                        }

                        if !root.profile-is-me: VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: "Report a finished trade";
                                font-weight: 700;
                            }

                            comment := LineEdit {
                                placeholder-text: "optional comment, e.g. \"$5 via PIX, fast\"";
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: "✓ Success";
                                    clicked => {
                                        root.report-trade(true, comment.text);
                                        comment.text = "";
                                    }
                                }

                                Button {
                                    text: "✗ Failure";
                                    clicked => {
                                        root.report-trade(false, comment.text);
                                        comment.text = "";
                                    }
                                }
                            }

                            Muted {
                                text: "reports are public, kept on this device and published to your current relays.";
                            }
                        }
                    }
                }

                // ---------------------------------------------------------------- people
                if root.page == 7: VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Title {
                        text: "People";
                    }

                    Muted {
                        text: "everyone you labeled. labels are kept only on this device, never published. label someone from their profile.";
                    }

                    LineEdit {
                        text <=> root.people-filter;
                        placeholder-text: "search labels or npubs";
                        edited(t) => {
                            root.people-filter-changed(t);
                        }
                    }

                    if root.people.length == 0: Muted {
                        text: root.people-filter == "" ? "nobody labeled yet." : "nobody matches.";
                    }
                    ListView {
                        vertical-stretch: 1;
                        for person in root.people: VerticalLayout {
                            padding-bottom: 8px;
                            padding-right: 6px;
                            Card {
                                TouchArea {
                                    clicked => {
                                        root.open-profile(person.npub);
                                    }
                                }

                                HorizontalLayout {
                                    padding: 10px;
                                    spacing: 8px;
                                    Label {
                                        text: person.label;
                                    }

                                    Muted {
                                        text: person.short;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // ---------------------------------------------------------------- settings
                if root.page == 6: sv6 := ScrollView {
                    VerticalLayout {
                        width: sv6.visible-width;
                        padding: 16px;
                        spacing: 10px;
                        alignment: start;
                        Title {
                            text: "Your key";
                        }

                        Muted {
                            text: "generated automatically on first launch. this npub is your only identity here.";
                        }

                        LineEdit {
                            text: root.npub;
                            read-only: true;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "My history";
                                clicked => {
                                    root.open-profile(root.npub);
                                }
                            }

                            Button {
                                text: root.nsec == "" ? "Reveal nsec" : "Hide nsec";
                                clicked => {
                                    root.reveal-nsec();
                                }
                            }
                        }

                        if root.nsec != "": LineEdit {
                            text: root.nsec;
                            read-only: true;
                        }

                        Title {
                            text: "Import a key";
                        }

                        Muted {
                            text: "use an nsec you had before. this brings back that identity and its reputation, but not its trades or messages, which stay on the device they happened on. your current key is kept on this device as a backup.";
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            import-field := LineEdit {
                                placeholder-text: "nsec1…";
                                input-type: password;
                            }

                            Button {
                                text: "Import";
                                enabled: import-field.text != "";
                                clicked => {
                                    root.import-nsec(import-field.text);
                                    import-field.text = "";
                                }
                            }
                        }
                        Title {
                            text: "Relays";
                        }

                        Muted {
                            text: "used to find offers, publish your offers and trade reports. paid relays only accept writes from paying users; switch to whatever relays you can use.";
                        }

                        for relay in root.relays: HorizontalLayout {
                            spacing: 8px;
                            Switch {
                                checked: relay.enabled;
                                toggled => {
                                    root.toggle-relay(relay.url, self.checked);
                                }
                            }

                            Text {
                                text: relay.url;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            Button {
                                text: "×";
                                clicked => {
                                    root.remove-relay(relay.url);
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            new-relay := LineEdit {
                                placeholder-text: "wss://…";
                            }

                            Button {
                                text: "Add";
                                clicked => {
                                    root.add-relay(new-relay.text);
                                    new-relay.text = "";
                                }
                            }
                        }
                    }
                }
            }
        }

        // bottom navigation
        Rectangle {
            height: 1px;
            background: Palette.border;
        }

        HorizontalLayout {
            padding-left: root.safe-area-insets.left + root.side-gap + 4px;
            padding-right: root.safe-area-insets.right + root.side-gap + 4px;
            padding-bottom: root.safe-area-insets.bottom;
            NavButton {
                text: "Market";
                active: root.page == 0 || root.page == 1;
                clicked => {
                    root.page = 0;
                }
            }

            NavButton {
                text: "New offer";
                active: root.page == 2;
                clicked => {
                    root.page = 2;
                }
            }

            NavButton {
                text: "Trades";
                active: root.page == 3 || root.page == 4;
                clicked => {
                    root.page = 3;
                }
            }

            NavButton {
                text: "People";
                active: root.page == 7;
                clicked => {
                    root.page = 7;
                }
            }

            NavButton {
                text: "Settings";
                active: root.page == 6;
                clicked => {
                    root.page = 6;
                }
            }
        }
    }
}
