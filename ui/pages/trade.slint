import {
    LineEdit,
    TextEdit,
    ScrollView,
    ListView,
    Palette,
} from "std-widgets.slint";
import { TradeView, MsgItem, PastReviewItem, DealView } from "../models.slint";
import { Card, Muted, Selectable, Identity, Button } from "../widgets.slint";
import { DealPanel } from "../deal.slint";
import { TradeActions } from "../trade_widgets.slint";

export component TradePage inherits VerticalLayout {
    in property <TradeView> trade;
    in property <[MsgItem]> messages;
    in property <[PastReviewItem]> reviews;
    in property <DealView> deal;
    in-out property <string> trade-confirming;
    in-out property <string> trade-details-draft;
    in-out property <bool> trade-concluding;
    in-out property <bool> trade-confirm-delete;
    in property <bool> trade-wide;
    callback open-profile(string);
    callback archive-trade();
    callback conclude-trade(bool, string);
    callback conclude-now();
    callback send-message(string);
    callback trade-pick-amount(string);
    callback trade-quote-price(string);
    callback trade-pick-bitcoin(string);
    callback trade-pick-payment(string);
    callback trade-give-details(string);
    pure callback trade-check-details(string) -> string;
    callback trade-mark-sent();
    callback delete-trade();
    callback delete-review(string);
    callback open-message-report(string);

    // whether the chat is scrolled to (near) the end, so new messages should keep it there
    property <bool> chat-follow: true;

    padding: 16px;
    spacing: 8px;

    // the offer, who it is with, and what can be done with the whole trade
    Card {
        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    // the peer's name stands in for the "maker" word of the summary sentence
                    HorizontalLayout {
                        spacing: 5px;
                        Identity {
                            text: root.trade.peer-name + (root.trade.blocked ? " (blocked)" : "");
                            tint: root.trade.peer-color;
                            font-size: 13px;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.open-profile(root.trade.peer);
                                }
                            }
                        }

                        Text {
                            text: root.trade.summary;
                            font-size: 13px;
                            font-weight: 700;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }

                if !root.trade.ongoing && !root.trade-concluding: Button {
                    text: root.reviews.length > 0 ? "Review again" : "Review";
                    small: true;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        root.trade-concluding = true;
                    }
                }
                if root.trade.pending && !root.trade-concluding: Button {
                    text: "Archive";
                    small: true;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        root.archive-trade();
                    }
                }
                if root.trade.ongoing && !root.trade-concluding: TradeActions {
                    conclude => {
                        root.conclude-now();
                    }
                    archive => {
                        root.archive-trade();
                    }
                }
            }

            if root.trade-concluding: VerticalLayout {
                spacing: 8px;
                Text {
                    text: "How did it go?";
                    font-weight: 700;
                }

                conclusion := LineEdit {
                    placeholder-text: "optional comment, e.g. \"$5 via PIX, fast\"";
                }

                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: "✓ Success";
                        clicked => {
                            root.conclude-trade(true, conclusion.text);
                        }
                    }

                    Button {
                        text: "✗ Failure";
                        clicked => {
                            root.conclude-trade(false, conclusion.text);
                        }
                    }

                    Button {
                        text: "Cancel";
                        clicked => {
                            root.trade-concluding = false;
                        }
                    }
                }
            }
        }
    }

    // what we reviewed about a trade that is over
    if !root.trade.ongoing && root.reviews.length > 0: Card {
        VerticalLayout {
            padding: 10px;
            spacing: 4px;
            for r in root.reviews: HorizontalLayout {
                spacing: 8px;
                Text {
                    text: r.success ? "✓" : "✗";
                    font-weight: 700;
                }

                Text {
                    text: (r.comment == "" ? "no comment" : "\"" + r.comment + "\"");
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }

                Muted {
                    text: r.time + " · " + r.relays + " relays";
                }

                Button {
                    text: "Delete";
                    small: true;
                    clicked => {
                        root.delete-review(r.id);
                    }
                }
            }
        }
    }

    // on wide screens the deal sits next to the chat, otherwise above it
    if root.deal.active && !root.trade-wide: sv-deal-top := ScrollView {
        height: min(dp-top.preferred-height, root.height * 0.45);
        // long unbreakable values, like an invoice, would widen it and push the panel sideways
        content-width: self.visible-width;
        VerticalLayout {
            width: sv-deal-top.visible-width;
            padding-right: 6px;
            dp-top := DealPanel {
                deal: root.deal;
                confirming <=> root.trade-confirming;
                draft <=> root.trade-details-draft;
                pick-amount(a) => {
                    root.trade-pick-amount(a);
                }
                quote-price(p) => {
                    root.trade-quote-price(p);
                }
                pick-bitcoin(m) => {
                    root.trade-pick-bitcoin(m);
                }
                pick-payment(m) => {
                    root.trade-pick-payment(m);
                }
                give-details(d) => {
                    root.trade-give-details(d);
                }
                check-details(d) => {
                    return root.trade-check-details(d);
                }
                mark-sent => {
                    root.trade-mark-sent();
                }
                ongoing: root.trade.ongoing;
                conclude => {
                    if root.trade.ongoing {
                        root.conclude-now();
                    } else {
                        root.trade-concluding = true;
                    }
                }
            }
        }
    }
    HorizontalLayout {
        vertical-stretch: 1;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            chat := ListView {
                vertical-stretch: 1;
                changed content-y => {
                    root.chat-follow = self.content-y <= self.height - self.content-height + 40px;
                }
                changed content-height => {
                    if root.chat-follow {
                        self.content-y = min(0px, self.height - self.content-height);
                    }
                }
                for msg in root.messages: HorizontalLayout {
                    padding-bottom: 6px;
                    padding-right: 6px;
                    alignment: msg.mine ? end : start;
                    spacing: 8px;
                    if !msg.meta: Rectangle {
                        width: min(300px, plain-text.preferred-width + 24px);
                        height: plain-layout.preferred-height;
                        border-radius: 10px;
                        background: msg.mine ? #f7931a33 : Palette.alternate-background;
                        plain-layout := VerticalLayout {
                            padding-top: 8px;
                            padding-bottom: 8px;
                            padding-left: 12px;
                            padding-right: 12px;
                            plain-text := Selectable {
                                text: msg.text;
                                wrap: word-wrap;
                            }

                            Muted {
                                text: msg.time;
                                horizontal-alignment: right;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.open-message-report(msg.id);
                                    }
                                }
                            }
                        }
                    }
                    // a structured message: an update to the deal, not something said
                    if msg.meta: Rectangle {
                        width: min(300px, meta-text.preferred-width + 24px);
                        height: meta-layout.preferred-height;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #1565c0;
                        background: #1565c022;
                        opacity: msg.ignored ? 0.5 : 1;
                        meta-layout := VerticalLayout {
                            padding-top: 8px;
                            padding-bottom: 8px;
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 2px;
                            meta-text := Selectable {
                                text: msg.text;
                                font-size: 13px;
                                font-weight: 700;
                                wrap: word-wrap;
                            }

                            Muted {
                                text: (msg.ignored ? "ignored, it didn't fit the deal · " : "") + msg.time;
                                horizontal-alignment: right;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.open-message-report(msg.id);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.trade.ongoing && !root.trade.blocked: HorizontalLayout {
                spacing: 8px;
                // enter sends, shift+enter goes to a new line
                FocusScope {
                    horizontal-stretch: 1;
                    height: 64px;
                    capture-key-pressed(event) => {
                        if event.text == Key.Return && !event.modifiers.shift {
                            root.send-message(input.text);
                            input.text = "";
                            return accept;
                        }
                        return reject;
                    }
                    input := TextEdit {
                        width: parent.width;
                        height: parent.height;
                        placeholder-text: "message";
                        wrap: word-wrap;
                    }
                }

                Button {
                    text: "Send";
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        root.send-message(input.text);
                        input.text = "";
                    }
                }
            }
            if !root.trade.ongoing: HorizontalLayout {
                spacing: 8px;
                Muted {
                    text: "this trade is over. messages are kept here as they were.";
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Button {
                    text: root.trade-confirm-delete ? "Really delete?" : "Delete";
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        if root.trade-confirm-delete {
                            root.delete-trade();
                        } else {
                            root.trade-confirm-delete = true;
                        }
                    }
                }
            }
        }

        if root.deal.active && root.trade-wide: sv-deal := ScrollView {
            width: 340px;
            content-width: self.visible-width;
            VerticalLayout {
                width: sv-deal.visible-width;
                padding-right: 6px;
                DealPanel {
                    deal: root.deal;
                    confirming <=> root.trade-confirming;
                    draft <=> root.trade-details-draft;
                    pick-amount(a) => {
                        root.trade-pick-amount(a);
                    }
                    quote-price(p) => {
                        root.trade-quote-price(p);
                    }
                    pick-bitcoin(m) => {
                        root.trade-pick-bitcoin(m);
                    }
                    pick-payment(m) => {
                        root.trade-pick-payment(m);
                    }
                    give-details(d) => {
                        root.trade-give-details(d);
                    }
                    check-details(d) => {
                        return root.trade-check-details(d);
                    }
                    mark-sent => {
                        root.trade-mark-sent();
                    }
                    ongoing: root.trade.ongoing;
                    conclude => {
                        if root.trade.ongoing {
                            root.conclude-now();
                        } else {
                            root.trade-concluding = true;
                        }
                    }
                }
            }
        }
    }
}
