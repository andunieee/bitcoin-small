import { ScrollView, Palette } from "std-widgets.slint";
import { OfferItem, HistoryItem, TradeItem, TradeView, DealView, MsgItem, PastReviewItem, ReviewItem, PersonItem, RelayItem, RelayAnswer, SentItem, PayItem } from "models.slint";
import { Card, Title, Button, NavButton } from "widgets.slint";
import { SentReport } from "trade_widgets.slint";
import { MarketPage } from "pages/market.slint";
import { OfferPage } from "pages/offer.slint";
import { CreatePage } from "pages/create.slint";
import { TradesPage } from "pages/trades.slint";
import { TradePage } from "pages/trade.slint";
import { ProfilePage } from "pages/profile.slint";
import { PeoplePage } from "pages/people.slint";
import { SettingsPage } from "pages/settings.slint";

export { OfferItem, HistoryItem, TradeItem, TradeView, DealRow, DealView, MsgItem, PastReviewItem, ReviewItem, PersonItem, RelayItem, RelayAnswer, SentItem, PayItem } from "models.slint";

export component AppWindow inherits Window {
    title: "bitcoin smol";
    preferred-width: 420px;
    preferred-height: 820px;
    background: Palette.background;

    // 0 market, 1 offer, 2 create, 3 trades, 4 trade, 5 profile, 6 settings, 7 people
    in-out property <int> page: 0;
    in-out property <int> back-page: 0;
    in property <string> status;
    in property <string> npub;
    in property <string> nsec;

    // market
    in property <[OfferItem]> offers;
    // starts with "all" so the filter's initial "all" is already in the model.
    // setup_ui replaces it with the full list, which keeps "all" first.
    in property <[string]> currencies: ["all"];
    in-out property <string> filter-side: "sellers and buyers";
    in-out property <string> filter-currency: "all";
    in property <bool> loading;
    // until we make or take an offer, the market points to the guide
    in property <bool> newcomer;
    in property <OfferItem> current-offer;
    // the recent trades shown on the offer page
    in property <[HistoryItem]> offer-history;
    in property <[TradeItem]> offer-trades;
    // how our trades with the maker went, and who we know traded with them
    in property <string> offer-stats;
    // our trades with the person on the profile page, ongoing and past
    in property <[TradeItem]> profile-trades;
    in property <string> profile-stats;
    in property <[RelayAnswer]> offer-answers;
    callback refresh-offers();
    callback filters-changed();
    callback open-offer(string);
    callback contact-maker(string);

    // create
    in property <[string]> create-currencies;
    in property <[string]> create-apis;
    // payment methods common for the chosen currency, and the rest behind "show more"
    in-out property <[PayItem]> payment-options;
    in-out property <[PayItem]> payment-more;
    in-out property <[PayItem]> bitcoin-options;
    in-out property <string> create-side: "sell";
    in-out property <string> create-currency;
    in-out property <string> create-api;
    in-out property <string> create-premium;
    in-out property <string> create-amount-min;
    in-out property <string> create-amount-max;
    // max follows min until it is edited to something else
    in-out property <bool> create-amount-linked: true;
    in-out property <string> create-other-payments;
    in property <[RelayItem]> negotiation-relays;
    in property <[RelayItem]> publish-relays;
    in-out property <string> create-description;
    in property <string> create-preview;
    in-out property <bool> create-custom;
    in-out property <bool> create-more-payments;
    callback create-currency-changed(string);
    callback create-api-changed(string);
    callback create-premium-changed();
    callback toggle-payment(string, bool);
    callback toggle-bitcoin(string, bool);
    callback publish-offer();

    // trades
    in property <[OfferItem]> my-offers;
    in property <[TradeItem]> ongoing-trades;
    in property <[TradeItem]> pending-trades;
    in property <[TradeItem]> past-trades;
    in property <TradeView> trade;
    in property <[MsgItem]> messages;
    // the reviews we published about the past trade shown
    in property <[PastReviewItem]> trade-reviews;
    in property <DealView> deal;
    in-out property <string> trade-confirming;
    in-out property <string> trade-details-draft;
    in-out property <bool> trade-concluding;
    in-out property <bool> trade-confirm-delete;
    callback open-trade(string);
    callback open-past-trade(string);
    callback close-offer(string);
    callback send-message(string);
    callback trade-pick-amount(string);
    pure callback offer-problem(string, string, string, string, string, [RelayItem], [RelayItem], [PayItem], [PayItem]) -> string;
    callback trade-quote-price(string);
    callback trade-pick-bitcoin(string);
    callback trade-pick-payment(string);
    callback trade-give-details(string);
    pure callback trade-check-details(string) -> string;
    callback trade-mark-sent();
    callback conclude-trade(bool, string);
    callback conclude-now();
    callback archive-trade();
    callback cancel-trade();
    callback delete-trade();
    callback delete-review(string);

    // profile
    in property <string> profile-npub;
    in property <string> profile-name;
    in property <color> profile-color;
    in property <string> profile-label;
    in property <bool> profile-blocked;
    in property <bool> profile-is-me;
    in property <[ReviewItem]> own-reviews;
    in property <[ReviewItem]> others-reviews;
    in property <string> others-note;
    callback open-profile(string);
    callback review-trade(bool, string);
    callback set-blocked(bool);
    callback set-label(string);

    // people
    in property <[PersonItem]> people;
    in-out property <string> people-filter;
    callback people-filter-changed(string);

    // settings
    in property <[RelayItem]> relays;
    // which is "settings", "negotiation" or "publish"
    callback relay-toggled(string, string, bool);
    callback relay-added(string, string);
    callback reveal-nsec();
    callback open-docs();
    callback import-nsec(string);
    in-out property <bool> show-reset-identity;

    // relay report popup, shown when most relays failed to take something we sent
    in property <[SentItem]> sent;
    in property <bool> sent-open;
    callback close-sent();
    callback open-relay-site(string);
    // the popup for one message, from its timestamp
    callback open-message-report(string);
    // the raw event of an "offer" or a "review", by its id
    callback open-raw(string, string);

    // on wide screens the content stays in a column of at most this width, centered by the stretch-0 spacers around it
    property <length> max-content-width: 1200px;
    // room for the deal panel next to the chat
    property <bool> trade-wide: root.width >= 760px;

    // false when there is nowhere to go back to, which is when the android back button leaves the app
    function go-back() -> bool {
        if root.sent-open {
            root.close-sent();
        } else if root.page == 1 || root.page == 5 {
            // the offer and the profile go back to wherever they were opened from
            root.page = root.back-page;
        } else if root.page == 4 {
            // the trade view is reached from the trades tab, or from a profile opened from it
            root.page = 3;
        } else if root.page != 0 {
            root.page = 0;
        } else {
            return false;
        }
        return true;
    }

    init => {
        keys.focus();
    }

    keys := FocusScope {
        capture-key-pressed(event) => {
            if event.text == Key.Back && root.go-back() {
                return accept;
            }
            return reject;
        }

            VerticalLayout {
            // header, extended under the status bar on phones that draw behind it
            Rectangle {
                height: 52px + root.safe-area-insets.top;
                background: #f7931a;
                HorizontalLayout {
                    padding-top: root.safe-area-insets.top + 8px;
                    padding-bottom: 8px;
                    padding-left: root.safe-area-insets.left;
                    padding-right: root.safe-area-insets.right;
                    Rectangle {
                        horizontal-stretch: 0;
                    }

                    HorizontalLayout {
                        max-width: root.max-content-width;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 8px;
                        if root.page == 1 || root.page == 4 || root.page == 5: Button {
                            text: "‹";
                            clicked => {
                                root.go-back();
                            }
                        }
                        Text {
                            text: "bitcoin smol";
                            color: white;
                            font-size: 18px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 0;
                    }
                }
            }

            // pages
            HorizontalLayout {
                vertical-stretch: 1;
                padding-left: root.safe-area-insets.left;
                padding-right: root.safe-area-insets.right;
                Rectangle {
                    horizontal-stretch: 0;
                }

                Rectangle {
                    max-width: root.max-content-width;
                    // ---------------------------------------------------------------- market
                    if root.page == 0: MarketPage {
                        open-raw(kind, id) => {
                            root.open-raw(kind, id);
                        }
                        offers: root.offers;
                        currencies: root.currencies;
                        filter-side <=> root.filter-side;
                        filter-currency <=> root.filter-currency;
                        loading: root.loading;
                        newcomer: root.newcomer;
                        refresh-offers => {
                            root.refresh-offers();
                        }
                        filters-changed => {
                            root.filters-changed();
                        }
                        open-offer(id) => {
                            root.open-offer(id);
                        }
                        open-docs => {
                            root.open-docs();
                        }
                    }

                    // ---------------------------------------------------------------- offer detail
                    if root.page == 1: OfferPage {
                        open-raw(kind, id) => {
                            root.open-raw(kind, id);
                        }
                        current-offer: root.current-offer;
                        history: root.offer-history;
                        trades: root.offer-trades;
                        stats: root.offer-stats;
                        answers: root.offer-answers;
                        open-relay-site(host) => {
                            root.open-relay-site(host);
                        }
                        open-trade(key) => {
                            root.open-trade(key);
                        }
                        open-past-trade(key) => {
                            root.open-past-trade(key);
                        }
                        open-profile(who) => {
                            root.open-profile(who);
                        }
                        contact-maker(id) => {
                            root.contact-maker(id);
                        }
                        close-offer(id) => {
                            root.close-offer(id);
                        }
                        open-history(id) => {
                            root.open-past-trade(id);
                        }
                        back => {
                            root.page = root.back-page;
                        }
                    }

                    // ---------------------------------------------------------------- create
                    if root.page == 2: CreatePage {
                        create-currencies: root.create-currencies;
                        create-apis: root.create-apis;
                        payment-options <=> root.payment-options;
                        payment-more <=> root.payment-more;
                        bitcoin-options <=> root.bitcoin-options;
                        create-side <=> root.create-side;
                        create-currency <=> root.create-currency;
                        create-api <=> root.create-api;
                        create-premium <=> root.create-premium;
                        create-amount-min <=> root.create-amount-min;
                        create-amount-max <=> root.create-amount-max;
                        create-amount-linked <=> root.create-amount-linked;
                        create-other-payments <=> root.create-other-payments;
                        negotiation-relays: root.negotiation-relays;
                        publish-relays: root.publish-relays;
                        relay-toggled(which, url, on) => {
                            root.relay-toggled(which, url, on);
                        }
                        relay-added(which, url) => {
                            root.relay-added(which, url);
                        }
                        create-description <=> root.create-description;
                        create-preview: root.create-preview;
                        create-custom <=> root.create-custom;
                        create-more-payments <=> root.create-more-payments;
                        create-currency-changed(c) => {
                            root.create-currency-changed(c);
                        }
                        create-api-changed(a) => {
                            root.create-api-changed(a);
                        }
                        create-premium-changed => {
                            root.create-premium-changed();
                        }
                        toggle-payment(name, checked) => {
                            root.toggle-payment(name, checked);
                        }
                        toggle-bitcoin(name, checked) => {
                            root.toggle-bitcoin(name, checked);
                        }
                        offer-problem(c, pr, mn, mx, o, r, pr2, b, p) => {
                            return root.offer-problem(c, pr, mn, mx, o, r, pr2, b, p);
                        }
                        publish-offer => {
                            root.publish-offer();
                        }
                    }

                    // ---------------------------------------------------------------- trades
                    if root.page == 3: TradesPage {
                        my-offers: root.my-offers;
                        ongoing-trades: root.ongoing-trades;
                        pending-trades: root.pending-trades;
                        past-trades: root.past-trades;
                        close-offer(id) => {
                            root.close-offer(id);
                        }
                        open-offer(id) => {
                            root.open-offer(id);
                        }
                        open-trade(key) => {
                            root.open-trade(key);
                        }
                        open-past-trade(key) => {
                            root.open-past-trade(key);
                        }
                    }

                    // ---------------------------------------------------------------- trade
                    if root.page == 4: TradePage {
                        open-raw(kind, id) => {
                            root.open-raw(kind, id);
                        }
                        trade: root.trade;
                        messages: root.messages;
                        reviews: root.trade-reviews;
                        deal: root.deal;
                        trade-confirming <=> root.trade-confirming;
                        trade-details-draft <=> root.trade-details-draft;
                        trade-concluding <=> root.trade-concluding;
                        trade-confirm-delete <=> root.trade-confirm-delete;
                        trade-wide: root.trade-wide;
                        open-profile(who) => {
                            root.open-profile(who);
                        }
                        archive-trade => {
                            root.archive-trade();
                        }
                        cancel-trade => {
                            root.cancel-trade();
                        }
                        conclude-now => {
                            root.conclude-now();
                        }
                        conclude-trade(success, comment) => {
                            root.conclude-trade(success, comment);
                        }
                        send-message(text) => {
                            root.send-message(text);
                        }
                        trade-pick-amount(text) => {
                            root.trade-pick-amount(text);
                        }
                        trade-quote-price(text) => {
                            root.trade-quote-price(text);
                        }
                        trade-pick-bitcoin(m) => {
                            root.trade-pick-bitcoin(m);
                        }
                        trade-pick-payment(m) => {
                            root.trade-pick-payment(m);
                        }
                        trade-give-details(d) => {
                            root.trade-give-details(d);
                        }
                        trade-check-details(d) => {
                            return root.trade-check-details(d);
                        }
                        trade-mark-sent => {
                            root.trade-mark-sent();
                        }
                        delete-review(id) => {
                            root.delete-review(id);
                        }
                        delete-trade => {
                            root.delete-trade();
                        }
                        open-message-report(id) => {
                            root.open-message-report(id);
                        }
                    }

                    // ---------------------------------------------------------------- profile
                    if root.page == 5: ProfilePage {
                        open-raw(kind, id) => {
                            root.open-raw(kind, id);
                        }
                        profile-npub: root.profile-npub;
                        profile-name: root.profile-name;
                        profile-color: root.profile-color;
                        profile-label: root.profile-label;
                        profile-blocked: root.profile-blocked;
                        profile-is-me: root.profile-is-me;
                        own-reviews: root.own-reviews;
                        others-reviews: root.others-reviews;
                        others-note: root.others-note;
                        trades: root.profile-trades;
                        stats: root.profile-stats;
                        open-trade(peer) => {
                            root.open-trade(peer);
                        }
                        open-past-trade(key) => {
                            root.open-past-trade(key);
                        }
                        review-trade(success, comment) => {
                            root.review-trade(success, comment);
                        }
                        set-blocked(blocked) => {
                            root.set-blocked(blocked);
                        }
                        set-label(label) => {
                            root.set-label(label);
                        }
                    }

                    // ---------------------------------------------------------------- people
                    if root.page == 7: PeoplePage {
                        people: root.people;
                        people-filter <=> root.people-filter;
                        people-filter-changed(t) => {
                            root.people-filter-changed(t);
                        }
                        open-profile(npub) => {
                            root.open-profile(npub);
                        }
                    }

                    // ---------------------------------------------------------------- settings
                    if root.page == 6: SettingsPage {
                        npub: root.npub;
                        nsec: root.nsec;
                        relays: root.relays;
                        show-reset-identity <=> root.show-reset-identity;
                        relay-toggled(which, url, on) => {
                            root.relay-toggled(which, url, on);
                        }
                        relay-added(which, url) => {
                            root.relay-added(which, url);
                        }
                        reveal-nsec => {
                            root.reveal-nsec();
                        }
                        open-profile(npub) => {
                            root.open-profile(npub);
                        }
                        import-nsec(nsec) => {
                            root.import-nsec(nsec);
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 0;
                }
            }

            // bottom navigation
            Rectangle {
                height: 1px;
                background: Palette.border;
            }

            HorizontalLayout {
                padding-left: root.safe-area-insets.left;
                padding-right: root.safe-area-insets.right;
                padding-bottom: root.safe-area-insets.bottom;
                Rectangle {
                    horizontal-stretch: 0;
                }

                HorizontalLayout {
                    max-width: root.max-content-width;
                    padding-left: 4px;
                    padding-right: 4px;
                    NavButton {
                        text: "Market";
                        active: root.page == 0 || root.page == 1;
                        clicked => {
                            root.page = 0;
                        }
                    }

                    NavButton {
                        text: "New offer";
                        active: root.page == 2;
                        clicked => {
                            root.page = 2;
                        }
                    }

                    NavButton {
                        text: "Trades";
                        active: root.page == 3 || root.page == 4;
                        clicked => {
                            root.page = 3;
                        }
                    }

                    NavButton {
                        text: "People";
                        active: root.page == 7;
                        clicked => {
                            root.page = 7;
                        }
                    }

                    NavButton {
                        text: "Settings";
                        active: root.page == 6;
                        clicked => {
                            root.page = 6;
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 0;
                }
            }
        }
    }
    // relay report popup, over everything else
    if root.sent-open: Rectangle {
        background: #00000088;
        // swallow clicks so nothing underneath reacts
        TouchArea {
            clicked => {
                root.close-sent();
            }
        }

        Card {
            width: min(root.width - 32px, 480px);
            height: min(root.height - 32px - root.safe-area-insets.top - root.safe-area-insets.bottom, 520px);
            background: Palette.background;
            // keep clicks on the card from closing it
            TouchArea { }

            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                Title {
                    text: "Relays";
                }

                sv-sent := ScrollView {
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    VerticalLayout {
                        width: sv-sent.visible-width;
                        padding-right: 6px;
                        spacing: 12px;
                        alignment: start;
                        for item in root.sent: SentReport {
                            item: item;
                            open-relay-site(host) => {
                                root.open-relay-site(host);
                            }
                        }
                    }
                }

                Button {
                    text: "Close";
                    clicked => {
                        root.close-sent();
                    }
                }
            }
        }
    }
}
