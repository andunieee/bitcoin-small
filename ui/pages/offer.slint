import { ScrollView, Palette } from "std-widgets.slint";
import { OfferItem, HistoryItem } from "../models.slint";
import { Card, Title, Muted, SideBadge, Identity, Button, RawTrigger } from "../widgets.slint";

export component OfferPage inherits ScrollView {
    in property <OfferItem> current-offer;
    in property <[HistoryItem]> history;
    callback open-profile(string);
    callback contact-maker(string);
    callback close-offer(string);
    callback open-history(string);
    callback back();
    callback open-raw(string, string);

    content-width: self.visible-width;

    VerticalLayout {
        width: root.visible-width;
        padding: 16px;
        spacing: 10px;
        alignment: start;
        HorizontalLayout {
            spacing: 8px;
            SideBadge {
                side: root.current-offer.side;
            }

            Title {
                text: "bitcoin for " + root.current-offer.currency;
            }
        }

        Card {
            RawTrigger {
                raw => {
                    root.open-raw("offer", root.current-offer.id);
                }
            }

            VerticalLayout {
                padding: 12px;
                spacing: 6px;
                Identity {
                    text: root.current-offer.maker-name;
                    tint: root.current-offer.maker-color;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.open-profile(root.current-offer.maker);
                        }
                    }
                }

                Text {
                    text: "price: market " + root.current-offer.premium + " (" + root.current-offer.price-api + ")";
                    wrap: word-wrap;
                }

                Text {
                    text: root.current-offer.price;
                    font-weight: 700;
                }

                Text {
                    text: "amount: " + root.current-offer.amount;
                    wrap: word-wrap;
                }

                Text {
                    text: "payment: " + root.current-offer.payments;
                    wrap: word-wrap;
                }

                Text {
                    text: "bitcoin via: " + root.current-offer.bitcoin;
                    wrap: word-wrap;
                }

                Muted {
                    text: "negotiation relays: " + root.current-offer.relays;
                }

                Muted {
                    text: "posted " + root.current-offer.age;
                }
            }
        }

        if root.current-offer.description != "": Card {
            VerticalLayout {
                padding: 12px;
                Text {
                    text: root.current-offer.description;
                    wrap: word-wrap;
                }
            }
        }
        if !root.current-offer.mine && root.history.length == 0: Muted {
            text: "you have never traded with them.";
        }

        if !root.current-offer.mine && root.history.length > 0: Card {
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text {
                    text: "Recent trades";
                    font-weight: 700;
                }

                for item in root.history: row := Rectangle {
                    background: row-area.has-hover && row-area.enabled ? Palette.alternate-background : transparent;
                    height: row-column-layout.preferred-height;
                    row-column-layout := HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 16px;
                            text: item.outcome == "success" ? "✓" : item.outcome == "failure" ? "✗" : "–";
                            color: item.outcome == "success" ? #2e7d32 : item.outcome == "failure" ? #c62828 : Palette.foreground.transparentize(40%);
                            font-weight: 700;
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            if item.peer-name != "": HorizontalLayout {
                                spacing: 4px;
                                Muted {
                                    text: "with";
                                    vertical-alignment: center;
                                }

                                Identity {
                                    text: item.peer-name;
                                    tint: item.peer-color;
                                    font-size: 12px;
                                    horizontal-stretch: 1;
                                }
                            }

                            Text {
                                text: item.comment != "" ? item.comment : (item.outcome == "success" ? "successful trade" : item.outcome == "failure" ? "failed trade" : "archived, no review");
                                wrap: word-wrap;
                            }
                        }

                        Muted {
                            text: item.time;
                        }
                    }

                    row-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.open-history(item.key);
                        }
                    }
                }
            }
        }
        // from the taker's point of view, like the badge
        if !root.current-offer.mine: Rectangle {
            height: 40px;
            border-radius: 4px;
            border-width: 2px;
            border-color: #f7931a;
            background: Palette.control-background.darker(take.pressed ? 0.15 : take.has-hover ? 0.07 : 0);
            take := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.contact-maker(root.current-offer.id);
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 5px;
                Text {
                    text: root.current-offer.side == "sell" ? "Buy Bitcoin from" : "Sell Bitcoin to";
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Identity {
                    text: root.current-offer.maker-name;
                    tint: root.current-offer.maker-color;
                }
            }
        }
        if root.current-offer.mine: Button {
            text: "Close offer";
            clicked => {
                root.close-offer(root.current-offer.id);
                root.back();
            }
        }
    }
}
