import { LineEdit, ScrollView } from "std-widgets.slint";
import { OfferItem, ReviewItem, TradeItem } from "../models.slint";
import { TradeCard } from "../trade_widgets.slint";
import { Card, Title, Muted, Identity, Button, RawTrigger, Selectable, SideBadge } from "../widgets.slint";

export component ProfilePage inherits ScrollView {
    in property <string> profile-npub;
    in property <string> profile-name;
    in property <color> profile-color;
    in property <string> profile-label;
    in property <bool> profile-blocked;
    in property <bool> profile-is-me;
    in property <[ReviewItem]> own-reviews;
    in property <[ReviewItem]> others-reviews;
    in property <string> others-note;
    in property <[TradeItem]> trades;
    in property <string> stats;
    in property <[OfferItem]> offers;
    in property <string> offers-note;
    callback open-offer(string);
    callback open-trade(string);
    callback open-past-trade(string);
    callback review-trade(bool, string);
    callback set-blocked(bool);
    callback set-label(string);
    callback open-raw(string, string);

    content-width: self.visible-width;

    // what is typed in the label field: only overwritten when the stored label changes
    property <string> label-draft: root.profile-label;
    changed profile-label => {
        root.label-draft = root.profile-label;
    }

    VerticalLayout {
        width: root.visible-width;
        padding: 16px;
        spacing: 10px;
        alignment: start;
        if root.profile-is-me: Title {
            text: "You";
        }
        if !root.profile-is-me: Identity {
            text: root.profile-name;
            tint: root.profile-color;
            font-size: 20px;
        }

        Selectable {
            text: root.profile-npub;
            font-size: 12px;
        }

        if !root.profile-is-me: HorizontalLayout {
            spacing: 8px;
            LineEdit {
                text <=> root.label-draft;
                placeholder-text: "label, only you see it";
                accepted => {
                    root.set-label(self.text);
                }
            }

            Button {
                text: "Save";
                enabled: root.label-draft != root.profile-label;
                clicked => {
                    root.set-label(root.label-draft);
                }
            }
        }

        if !root.profile-is-me: HorizontalLayout {
            spacing: 8px;
            Button {
                text: "Message";
                enabled: !root.profile-blocked;
                clicked => {
                    root.open-trade(root.profile-npub);
                }
            }

            Button {
                text: root.profile-blocked ? "Unblock" : "Block";
                clicked => {
                    root.set-blocked(!root.profile-blocked);
                }
            }
        }

        if !root.profile-is-me: Text {
            text: "Their offers";
            font-weight: 700;
        }

        if !root.profile-is-me && root.offers-note != "": Muted {
            text: root.offers-note;
        }
        for offer in root.offers: Card {
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.open-offer(offer.id);
                }
            }

            VerticalLayout {
                padding: 10px;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 8px;
                    SideBadge {
                        side: offer.side;
                    }

                    Text {
                        text: offer.currency + " " + offer.premium;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Text {
                        text: offer.price;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }

                Text {
                    text: offer.amount;
                    font-size: 13px;
                }

                Muted {
                    text: offer.payments + " · " + offer.age;
                    wrap: word-wrap;
                }
            }
        }

        if !root.profile-is-me: Text {
            text: "Your trades with them";
            font-weight: 700;
        }

        if !root.profile-is-me: Muted {
            text: root.stats;
        }
        for t in root.trades: TradeCard {
            item: t;
            clicked => {
                if t.ongoing {
                    root.open-trade(t.key);
                } else {
                    root.open-past-trade(t.key);
                }
            }
        }

        Text {
            text: root.profile-is-me ? "Your trade reviews" : "Your history with them";
            font-weight: 700;
        }

        if root.own-reviews.length == 0: Muted {
            text: "you have never traded with them.";
        }
        for rep in root.own-reviews: Card {
            RawTrigger {
                raw => {
                    root.open-raw("review", rep.id);
                }
            }

            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                Text {
                    text: rep.success ? "✓" : "✗";
                    color: rep.success ? #2e7d32 : #c62828;
                    font-weight: 700;
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    if rep.subject-name != "": HorizontalLayout {
                        spacing: 4px;
                        Muted {
                            text: "with";
                            vertical-alignment: center;
                        }

                        Identity {
                            text: rep.subject-name;
                            tint: rep.subject-color;
                            font-size: 12px;
                            horizontal-stretch: 1;
                        }
                    }
                    Text {
                        text: rep.comment != "" ? rep.comment : (rep.success ? "successful trade" : "failed trade");
                        wrap: word-wrap;
                    }
                }

                Muted {
                    text: rep.time;
                }
            }
        }

        if !root.profile-is-me: Text {
            text: "What the people you trust say";
            font-weight: 700;
        }

        if !root.profile-is-me: Muted {
            text: root.others-note;
        }

        for rep in root.others-reviews: Card {
            RawTrigger {
                raw => {
                    root.open-raw("review", rep.id);
                }
            }

            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                Text {
                    text: rep.success ? "✓" : "✗";
                    color: rep.success ? #2e7d32 : #c62828;
                    font-weight: 700;
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    Text {
                        text: rep.comment != "" ? rep.comment : (rep.success ? "successful trade" : "failed trade");
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        Muted {
                            text: "by";
                            vertical-alignment: center;
                        }

                        Identity {
                            text: rep.author-name;
                            tint: rep.author-color;
                            font-size: 12px;
                        }

                        Muted {
                            text: "· " + rep.time;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }

        if !root.profile-is-me: VerticalLayout {
            spacing: 8px;
            Text {
                text: "Review a finished trade";
                font-weight: 700;
            }

            comment := LineEdit {
                placeholder-text: "optional comment, e.g. \"$5 via PIX, fast\"";
            }

            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "✓ Success";
                    clicked => {
                        root.review-trade(true, comment.text);
                        comment.text = "";
                    }
                }

                Button {
                    text: "✗ Failure";
                    clicked => {
                        root.review-trade(false, comment.text);
                        comment.text = "";
                    }
                }
            }
        }
    }
}
