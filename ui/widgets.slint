import { Palette, LineEdit } from "std-widgets.slint";

export component Card inherits Rectangle {
    // marks something as ours
    in property <bool> mine;
    background: root.mine ? #f7931a22 : Palette.alternate-background;
    border-radius: 8px;
    border-width: root.mine ? 2px : 1px;
    border-color: root.mine ? #f7931a : Palette.border;
}

// a touch area that also reports a right click or a long press, to inspect what it shows.
// clicked doesn't fire as a click when it was a long press, check `held` there
export component RawTrigger inherits TouchArea {
    callback raw();
    out property <bool> held;
    timer := Timer {
        interval: 600ms;
        running: false;
        triggered => {
            self.running = false;
            root.held = true;
            root.raw();
        }
    }

    pointer-event(e) => {
        if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
            root.raw();
        } else if e.button == PointerEventButton.left {
            if e.kind == PointerEventKind.down {
                root.held = false;
                timer.running = true;
            } else {
                timer.running = false;
            }
        } else if e.kind == PointerEventKind.cancel {
            timer.running = false;
        }
    }

    moved => {
        timer.running = false;
    }
}

// text that can be selected and copied
export component Selectable inherits TextInput {
    color: Palette.foreground;
    read-only: true;
    wrap: word-wrap;
    single-line: false;
}

export component Title inherits Text {
    font-size: 20px;
    font-weight: 700;
    wrap: word-wrap;
}

export component Muted inherits Text {
    color: Palette.foreground.transparentize(40%);
    font-size: 12px;
    wrap: word-wrap;
}

export component Tip inherits Rectangle {
    in property <string> text;
    background: #f7931a22;
    border-radius: 6px;
    VerticalLayout {
        padding: 8px;
        Text {
            text: root.text;
            wrap: word-wrap;
            font-size: 12px;
        }
    }
}

export component NavButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    height: 52px;
    background: area.pressed ? Palette.selection-background.transparentize(60%) : transparent;
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Text {
        text: root.text;
        color: root.active ? #f7931a : Palette.foreground;
        font-weight: root.active ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component SideBadge inherits Rectangle {
    in property <string> side;
    height: 22px;
    border-radius: 4px;
    background: side == "sell" ? #2e7d32 : #1565c0;
    // badge describes what the maker does; a maker who sells is someone you can buy from
    text := Text {
        text: root.side == "sell" ? "SELLING BITCOIN" : "BUYING BITCOIN";
        color: white;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    width: text.preferred-width + 12px;
}

// someone, by our label for them or by their short key, in a color that comes from their key
export component Identity inherits Text {
    in property <color> tint;
    font-weight: 700;
    // the tint is dark enough to read on light backgrounds
    color: Palette.color-scheme == ColorScheme.dark ? root.tint.mix(white, 0.6) : root.tint;
    vertical-alignment: center;
    overflow: elide;
}

// the std button can't show a pointer cursor, its own touch area always sets the default one
export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <bool> small;
    callback clicked;
    // a click while disabled
    callback disabled-clicked;
    // grows taller when a long label has to wrap
    min-height: max(root.small ? 26px : 32px, t.preferred-height + (root.small ? 8px : 12px));
    min-width: 32px;
    preferred-width: t.preferred-width + (root.small ? 16px : 24px);
    horizontal-stretch: 0;
    border-radius: 4px;
    border-width: root.primary ? 0 : 1px;
    border-color: Palette.border.transparentize(40%);
    opacity: root.enabled ? 1 : 0.5;
    background: (root.primary ? Palette.accent-background : Palette.control-background)
        .darker(!root.enabled ? 0 : area.pressed ? 0.15 : area.has-hover ? 0.07 : 0);
    area := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if root.enabled {
                root.clicked();
            } else {
                root.disabled-clicked();
            }
        }
    }

    t := Text {
        x: 6px;
        width: parent.width - 12px;
        text: root.text;
        wrap: word-wrap;
        color: root.primary ? Palette.accent-foreground : Palette.control-foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component Choices inherits Card {
    in property <string> title;
    in property <[string]> options;
    callback picked(string);
    VerticalLayout {
        padding-top: 8px;
        padding-bottom: 8px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 4px;
        Text {
            text: root.title;
            font-weight: 700;
            wrap: word-wrap;
        }

        for option in root.options: Button {
            text: option;
            clicked => {
                root.picked(option);
            }
        }
    }
}

// a text field for a signed number with up and down buttons, like a browser's number input.
// it stays text so that a minus sign can be typed on every keyboard.
export component NumberEdit inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <float> step: 1;
    callback edited();
    min-height: 32px;
    preferred-height: 32px;

    function nudge(direction: float) {
        // rounded so that 0.1 steps don't leave float noise behind
        root.text = "" + Math.round((root.text.to-float() + direction * root.step) * 1000) / 1000;
        root.edited();
    }

    LineEdit {
        x: 0;
        width: parent.width - 22px;
        height: parent.height;
        text <=> root.text;
        placeholder-text: root.placeholder-text;
        input-type: InputType.text;
        edited => {
            root.edited();
        }
    }

    for direction[i] in [1, -1]: Rectangle {
        x: parent.width - 20px;
        y: i == 0 ? 0px : parent.height / 2 + 1px;
        width: 20px;
        height: parent.height / 2 - 1px;
        border-radius: 3px;
        border-width: 1px;
        border-color: Palette.border.transparentize(40%);
        background: Palette.control-background.darker(arrow.pressed ? 0.15 : arrow.has-hover ? 0.07 : 0);
        arrow := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.nudge(direction);
            }
        }

        Text {
            text: i == 0 ? "▲" : "▼";
            font-size: 8px;
            color: Palette.control-foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
